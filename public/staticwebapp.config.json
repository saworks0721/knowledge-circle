{
  "routes": [
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/login/microsoft", "redirect": "/.auth/login/aad?post_login_redirect_uri=/" },
    { "route": "/login/github", "redirect": "/.auth/login/github?post_login_redirect_uri=/" },
    { "route": "/logout", "redirect": "/.auth/logout?post_logout_redirect_uri=/" }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/api/*", "/*.{svg,png,ico,css,js}"]
  }
}
